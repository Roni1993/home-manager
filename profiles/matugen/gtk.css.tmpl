/* matugen-generated GTK theme override (gtk-3.0 + gtk-4.0)
   Surface backgrounds are intentionally NOT overridden: GTK/libadwaita owns
   them so light/dark follows color-scheme correctly without app restarts.
   Only the palette variables + accent are supplied by matugen. */
@import 'colors.css';

@define-color bg_color {{ colors.surface.default.hex }};
@define-color fg_color {{ colors.on_surface.default.hex }};
@define-color base_color {{ colors.surface_container.default.hex }};
@define-color text_color {{ colors.on_surface.default.hex }};
@define-color selected_bg_color {{ colors.primary.default.hex }};
@define-color selected_fg_color {{ colors.on_primary.default.hex }};
@define-color tooltip_bg_color {{ colors.inverse_surface.default.hex }};
@define-color tooltip_fg_color {{ colors.inverse_on_surface.default.hex }};
@define-color borders {{ colors.outline.default.hex }};
@define-color accent_color {{ colors.primary.default.hex }};
@define-color accent_bg_color {{ colors.primary.default.hex }};
@define-color accent_fg_color {{ colors.on_primary.default.hex }};
@define-color destructive_color {{ colors.error.default.hex }};

/* libadwaita (GTK4) variable names — needed for zapzap etc. */
@define-color theme_bg_color {{ colors.surface.default.hex }};
@define-color theme_fg_color {{ colors.on_surface.default.hex }};
@define-color theme_base_color {{ colors.surface_container.default.hex }};
@define-color theme_text_color {{ colors.on_surface.default.hex }};
@define-color theme_selected_bg_color {{ colors.primary.default.hex }};
@define-color theme_selected_fg_color {{ colors.on_primary.default.hex }};
@define-color theme_unfocused_bg_color {{ colors.surface.default.hex }};
@define-color theme_unfocused_fg_color {{ colors.on_surface.default.hex }};
@define-color theme_unfocused_base_color {{ colors.surface_container.default.hex }};
@define-color theme_unfocused_text_color {{ colors.on_surface.default.hex }};
@define-color theme_tooltip_bg_color {{ colors.inverse_surface.default.hex }};
@define-color theme_tooltip_fg_color {{ colors.inverse_on_surface.default.hex }};
@define-color theme_borders {{ colors.outline.default.hex }};

/* matugen accent tinting (kept minimal so light/dark surfaces stay correct) */
selection, *:selected { background-color: @selected_bg_color; color: @selected_fg_color; }
* { outline-color: @accent_color; }
