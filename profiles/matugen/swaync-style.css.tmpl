.notification-row { outline: none; }
.notification { background: {{ colors.surface.default.hex }}; color: {{ colors.on_surface.default.hex }}; border-radius: 10px; margin: 6px 12px; padding: 10px; }
.notification-default-action { border-radius: 10px; }
.notification-default-action:hover { background: {{ colors.surface_variant.default.hex }}; }
.notification-content { padding: 6px; }
.summary { font-weight: bold; color: {{ colors.primary.default.hex }}; }
.body { color: {{ colors.on_surface_variant.default.hex }}; }
.close-button { background: {{ colors.surface_variant.default.hex }}; border-radius: 50%; margin: 0 4px; }
.close-button:hover { background: {{ colors.error.default.hex }}; }
